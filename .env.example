# Copy to .env.local for local development. Every value is blank on purpose:
# code treats a blank value as unset. Production values go straight into the
# Vercel project's environment variables, never into a file or a chat.

# Sign-in (NextAuth). NEXTAUTH_URL is the address the site is served from;
# locally, the http://localhost address `npm run dev` prints. NEXTAUTH_SECRET
# signs and encrypts the session cookie: a long random value, for example the
# output of `openssl rand -base64 32`, different in every environment.
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Google, GitHub and LinkedIn sign-in. Each provider switches on once both of
# its values are set; until then its button says it isn't available yet.
# Setup steps: engineering standards, docs/engineering/SIGN_IN_SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Error tracking (server only, production only). The Sentry integration in
# Vercel sets it; without it nothing is sent.
SENTRY_DSN=

# Local database for the seed scripts (scripts/seed.ts, scripts/reset-db.ts).
# A connection string naming a local database, with no user or password in it
# when your local Postgres trusts local connections. The app does not use a
# database yet.
DATABASE_URL=

# Planned integrations, not used by any code yet. Each gets its monthly spend
# cap in code before its first call (engineering standards, section 20).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YELP_API_KEY=
GOOGLE_REVIEWS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
